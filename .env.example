# ==============================================================================
# TwinGuard AI - Environment Variables Configuration (.env.example)
# Copy this file to .env and insert your API credentials.
# Vite requires variables accessible in the browser to start with 'VITE_'.
# ==============================================================================

# Google Gemini API Key for Live AI Incident Commander & Egress Reasoning
# Get your free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gemini Model Selection (Recommended: gemini-1.5-flash or gemini-2.0-flash)
VITE_GEMINI_MODEL=gemini-1.5-flash

# Backend Digital Twin WebSocket / Sensor Telemetry Server URL
VITE_API_URL=http://localhost:5000

